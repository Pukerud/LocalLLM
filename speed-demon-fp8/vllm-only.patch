+            q = unpack_from_int32(packed, bits, torch.Size([out_f, in_f]), packed_dim=1)
+            group = in_f // int(group_scale.shape[1])
+            dense = (
+                q.to(torch.float32).reshape(out_f, in_f // group, group)
+                * group_scale.to(torch.float32)[..., None]
+            ).reshape(out_f, in_f)
